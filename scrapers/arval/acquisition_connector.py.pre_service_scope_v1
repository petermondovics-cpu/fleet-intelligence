import re
from typing import Optional


class ArvalAcquisitionConnector:
    """
    Arval Acquisition Connector V2.

    Changes from V1:
    - contract discovery now requires a DIFFERENT priced contract variant
      from the current comparison contract;
    - matching uses the canonical vehicle key;
    - current contract dimensions can be supplied through task metadata;
    - same 60 hó / 20,000 km offer is rejected as non-resolving evidence.

    Existing safety rules remain:
    - only Arval provider pages for commercial evidence;
    - explicit price + duration + mileage required;
    - no synthetic contract factors;
    - no silent 20% down-payment assumption;
    - no inference from absence.
    """

    SERVICE_URLS = (
        "https://www.arval.hu/kis-es-kozepvallalkozasok/"
        "tartos-berlet-vagy-vasarlas-miert-jobb-berelni",
        "https://www.arval.hu/jarmuvezetok/sofortamogato-kozpont",
        "https://www.arval.hu/jarmuvezetok/"
        "tekintse-at-a-gyakran-ismetelt-kerdeseket",
    )

    FINANCIAL_URLS = (
        "https://www.arval.hu/kis-es-kozepvallalkozasok/"
        "tartos-berlet-vagy-vasarlas-miert-jobb-berelni",
        "https://www.arval.hu/nagyvallalatok/"
        "operativ-lizing-es-penzugyi-lizing-osszehasonlitas",
    )

    LIST_URL = (
        "https://www.arval.hu/kis-es-kozepvallalkozasok/"
        "ajanlat-hosszu-tavu-igenyekre"
    )

    def __init__(
        self,
        browser,
        *,
        canonical_key_builder,
    ):
        self.browser = browser
        self.canonical_key_builder = canonical_key_builder

    def contract_discovery(self, task):
        candidates = self._discover_offer_urls()
        target_key = task.canonical_vehicle_key

        current_duration = getattr(
            task,
            "current_duration",
            None,
        )
        current_mileage = getattr(
            task,
            "current_mileage",
            None,
        )

        for url in candidates:
            page = self.browser.new_page()

            try:
                page.goto(
                    url,
                    wait_until="domcontentloaded",
                    timeout=60000,
                )
                page.wait_for_timeout(1200)
                self._dismiss(page)

                from scrapers.arval.evidence_aware_builder import (
                    ArvalEvidenceAwareBuilder,
                )

                wrapped = (
                    ArvalEvidenceAwareBuilder()
                    .build(page)
                )

                key = self.canonical_key_builder(
                    wrapped
                )

                if key != target_key:
                    continue

                offer = wrapped.composite.offer

                # The evidence must actually resolve a contract gap.
                if (
                    current_duration is not None
                    and current_mileage is not None
                    and offer.duration == current_duration
                    and offer.mileage == current_mileage
                ):
                    continue

                return {
                    "source_type": "PROVIDER_PRICED_OFFER_PAGE",
                    "source_url": offer.url,
                    "source_text": (
                        f"{offer.brand} {offer.model} {offer.trim}; "
                        f"{offer.duration} hó; "
                        f"{offer.mileage} km/év; "
                        f"{offer.monthly_fee} Ft/hó"
                    ),
                    "provider": offer.provider,
                    "brand": offer.brand,
                    "model": offer.model,
                    "trim": offer.trim,
                    "fuel_type": offer.fuel_type,
                    "monthly_fee": offer.monthly_fee,
                    "duration": offer.duration,
                    "mileage": offer.mileage,
                }

            except Exception:
                continue

            finally:
                page.close()

        return None

    def financial_discovery(self, task):
        for url in self.FINANCIAL_URLS:
            page = self.browser.new_page()

            try:
                page.goto(
                    url,
                    wait_until="domcontentloaded",
                    timeout=60000,
                )
                page.wait_for_timeout(1000)
                self._dismiss(page)

                text = page.locator("body").inner_text()

                parsed = self._parse_down_payment(
                    text
                )

                if parsed is None:
                    continue

                result = {
                    "source_type": "PROVIDER_TERMS_OR_PDF",
                    "source_url": url,
                    "source_text": parsed["source_text"],
                }

                result.update(parsed["payload"])

                return result

            except Exception:
                continue

            finally:
                page.close()

        return None

    def service_discovery(self, task):
        assertions = []
        source_lines = []
        source_url = None

        for url in self.SERVICE_URLS:
            page = self.browser.new_page()

            try:
                page.goto(
                    url,
                    wait_until="domcontentloaded",
                    timeout=60000,
                )
                page.wait_for_timeout(1000)
                self._dismiss(page)

                text = page.locator("body").inner_text()
                found = self._parse_services(text)

                if found:
                    source_url = source_url or url

                    for item in found:
                        if item not in assertions:
                            assertions.append(item)

                    source_lines.extend(
                        item["source_text"]
                        for item in found
                    )

            except Exception:
                continue

            finally:
                page.close()

        if not assertions:
            return None

        return {
            "source_type": "PROVIDER_SERVICE_PAGE",
            "source_url": source_url,
            "source_text": " | ".join(
                source_lines
            ),
            "services": assertions,
        }

    def _discover_offer_urls(self):
        page = self.browser.new_page()

        try:
            page.goto(
                self.LIST_URL,
                wait_until="domcontentloaded",
                timeout=60000,
            )
            page.wait_for_timeout(1500)
            self._dismiss(page)

            urls = page.locator(
                "a[href*='/tartos-berleti-ajantlat/']"
            ).evaluate_all(
                "els => els.map(a => a.href)"
            )

            out = []
            seen = set()

            for url in urls:
                url = url.split("?")[0]

                if url in seen:
                    continue

                seen.add(url)
                out.append(url)

            return out

        finally:
            page.close()

    @staticmethod
    def _parse_down_payment(text: str) -> Optional[dict]:
        patterns = [
            (
                r"(?i)(?:önerő|kezdő\s*bérleti\s*díj|induló\s*díj)"
                r"[^%\n]{0,80}?(\d{1,3}(?:[.,]\d+)?)\s*%",
                "percent",
            ),
            (
                r"(?i)(\d{1,3}(?:[.,]\d+)?)\s*%"
                r"[^.\n]{0,80}?(?:önerő|kezdő\s*bérleti\s*díj|induló\s*díj)",
                "percent",
            ),
            (
                r"(?i)(?:önerő|kezdő\s*bérleti\s*díj|induló\s*díj)"
                r"[^0-9\n]{0,40}?([\d .]+)\s*(?:ft|forint)",
                "amount",
            ),
        ]

        for pattern, kind in patterns:
            match = re.search(pattern, text)

            if not match:
                continue

            raw = match.group(1)

            if kind == "percent":
                value = float(
                    raw.replace(",", ".")
                )

                if not 0 <= value <= 100:
                    continue

                return {
                    "source_text": match.group(0),
                    "payload": {
                        "down_payment_percent": value,
                    },
                }

            digits = re.sub(
                r"\D",
                "",
                raw,
            )

            if not digits:
                continue

            return {
                "source_text": match.group(0),
                "payload": {
                    "down_payment_amount": int(digits),
                },
            }

        return None

    @staticmethod
    def _parse_services(text: str):
        checks = (
            ("MAINTENANCE", ("szerviz és karbantartás", "karbantartás és javítás")),
            ("TYRES", ("szezonális gumicsere", "gumicserét", "gumiabroncs")),
            ("INSURANCE", ("baleset és biztosítás", "biztosítás")),
            ("CLAIMS_MANAGEMENT", ("káresemény", "károk")),
            ("ROADSIDE_ASSISTANCE", ("közúti segítségnyújtás",)),
            ("FLEET_PORTAL", ("my arval",)),
            ("FINANCING", ("finanszírozását", "finanszírozás")),
        )

        lowered = text.casefold()
        found = []

        for code, aliases in checks:
            for alias in aliases:
                idx = lowered.find(alias.casefold())

                if idx < 0:
                    continue

                start = max(0, idx - 80)
                end = min(
                    len(text),
                    idx + len(alias) + 120,
                )

                snippet = " ".join(
                    text[start:end].split()
                )

                found.append(
                    {
                        "code": code,
                        "included": True,
                        "source_text": snippet,
                    }
                )
                break

        return found

    @staticmethod
    def _dismiss(page):
        for selector in (
            "#onetrust-reject-all-handler",
            "#onetrust-accept-btn-handler",
            "button:has-text('Összes elfogadása')",
            "button:has-text('Elfogadom')",
            "button:has-text('Elutasítom')",
        ):
            loc = page.locator(selector)

            if loc.count() == 0:
                continue

            try:
                loc.first.click(timeout=1500)
                page.wait_for_timeout(200)
                return
            except Exception:
                pass
